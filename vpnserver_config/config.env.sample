# Sample VPN server configuration: copy to vpnserver_config/config.env and edit
#
# Adapted from Fed-BioMed (Apache-2.0):
# https://github.com/fedbiomed/fedbiomed/blob/v6.4.1/envs/vpn/docker/vpnserver/run_mounts/config/config.env.sample

# required: public IP or DNS name of the machine hosting the VPN server,
# eg : VPN_SERVER_PUBLIC_ADDR=192.168.1.1
export VPN_SERVER_PUBLIC_ADDR=

export VPN_IP=10.220.0.1
export VPN_SUBNET_PREFIX=14
export VPN_MANAGEMENT_IP_ASSIGN=10.220.0.0/16
export VPN_NODE_IP_ASSIGN=10.221.0.0/16
export VPN_RESEARCHER_IP_ASSIGN=10.222.0.0/16
